# Passkey Proxy Configuration
# Copy this file to .env and customize for your environment

# Proxy server settings
# Host to bind the proxy server to (use 0.0.0.0 to listen on all interfaces)
PROXY_LISTEN_HOST=0.0.0.0

# Port for the proxy server to listen on
PROXY_LISTEN_PORT=8080

# Target application settings
# The backend application that the proxy will protect
TARGET_HOST=localhost
TARGET_PORT=3000

# Security settings
# JWT secret key for signing session tokens
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If not set, a random key will be generated on each startup (sessions will be invalidated on restart)
JWT_SECRET_KEY=

# Session expiry in hours
SESSION_EXPIRY_HOURS=24

# WebAuthn settings
# The relying party name shown to users during passkey registration
RP_NAME=Passkey Proxy

# Storage settings
# File path for storing passkey credentials (JSON format)
CREDENTIALS_FILE=./credentials.json
